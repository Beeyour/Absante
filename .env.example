# Copy this file to `.env` and change the values before deploying.

DOCTOR_PASSWORD=change-me
SECRET_KEY=change-this-secret-in-production
TOKEN_TTL_HOURS=12
APP_TIMEZONE=Asia/Riyadh

# Comma-separated browser origins that may call the API.
# Not required when the built frontend is served by the same FastAPI process.
# Example if the UI is on another domain: https://attendance.example.com
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
